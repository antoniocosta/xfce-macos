#!/usr/bin/env python3
"""vpntray: a light top-bar panel for a VPN command-line tool (unofficial; not affiliated with AdGuard).

Event-driven: no timers while idle. The status is read at start, when the panel opens and after
each action (with a few quick re-checks only while a connect/disconnect is settling).
"""
import os
import sys
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from vpntray_core import AdGuard  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3 as AppIndicator  # noqa: E402
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.vpntray.Tray"
WIDTH = 340
CSS = b"""
.vt-status { font-size: 15px; font-weight: bold; }
.vt-dim { opacity: 0.65; font-size: 11px; }
.vt-error { color: #e5484d; font-size: 11px; }
"""


def bg(fn, done):
    """Run fn in a thread; call done(result) on the GTK main loop."""
    def work():
        try:
            res = fn()
        except Exception as e:  # never let a worker die silently
            res = e
        GLib.idle_add(done, res)
    threading.Thread(target=work, daemon=True).start()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        askpass = os.path.join(HERE, "vpntray-askpass")
        self.vpn = AdGuard(os.environ.get("VPNTRAY_CLI", "adguardvpn-cli"), askpass)
        self.status = None
        self.account = None
        self.locations = []
        self.loc_time = 0.0
        self.busy = False
        self.shown_at = 0.0
        self.win = None
        self.indicator = None

    # ---- lifecycle ------------------------------------------------------------------
    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        if self.win is None:
            self.hold()
            self.build_indicator()
            self.build_window()
            self.refresh(status_only=True)
        if "--background" not in args:
            self.show_panel()
        return 0

    # ---- tray -----------------------------------------------------------------------
    def build_indicator(self):
        icons = os.path.join(HERE, "icons")
        icon_dir = icons if os.path.isdir(icons) else ""
        self.indicator = AppIndicator.Indicator.new_with_path(
            "vpntray", "vpntray-off-symbolic", AppIndicator.IndicatorCategory.APPLICATION_STATUS,
            icon_dir)
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        menu = Gtk.Menu()
        self.mi_state = Gtk.MenuItem(label=f"{self.vpn.name}: ...")
        self.mi_state.set_sensitive(False)
        self.mi_open = Gtk.MenuItem(label="Open panel")
        self.mi_open.connect("activate", lambda *_: self.show_panel())
        self.mi_toggle = Gtk.MenuItem(label="Connect")
        self.mi_toggle.connect("activate", lambda *_: self.toggle())
        mi_quit = Gtk.MenuItem(label="Quit")
        mi_quit.connect("activate", lambda *_: self.quit())
        for mi in (self.mi_open, self.mi_state, self.mi_toggle, Gtk.SeparatorMenuItem(), mi_quit):
            menu.append(mi)
        menu.show_all()
        self.indicator.set_menu(menu)
        self.indicator.set_secondary_activate_target(self.mi_open)  # middle click

    def update_tray(self):
        on = bool(self.status and self.status.connected)
        self.indicator.set_icon_full("vpntray-on-symbolic" if on else "vpntray-off-symbolic",
                                     f"{self.vpn.name} on" if on else f"{self.vpn.name} off")
        self.mi_state.set_label(f"{self.vpn.name}: connected" + (f" ({self.status.location})" if self.status.location else "")
                                if on else f"{self.vpn.name}: disconnected")
        self.mi_toggle.set_label("Disconnect" if on else "Connect")
        self.mi_toggle.set_sensitive(not self.busy and bool(self.account is None or self.account.logged_in))

    # ---- panel ----------------------------------------------------------------------
    def build_window(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        w = self.win = Gtk.Window(title=self.vpn.name)
        w.set_decorated(False)
        w.set_resizable(False)
        w.set_skip_taskbar_hint(True)
        w.set_skip_pager_hint(True)
        w.set_keep_above(True)
        w.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        w.set_default_size(WIDTH, -1)
        w.stick()
        w.connect("focus-out-event", self.on_focus_out)
        w.connect("key-press-event", lambda _w, e: self.win.hide() if e.keyval == Gdk.KEY_Escape else None)
        w.connect("delete-event", lambda *_: w.hide_on_delete())

        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.OUT)
        w.add(frame)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(12)
        frame.add(box)

        self.error = Gtk.Label(xalign=0)
        self.error.set_line_wrap(True)
        self.error.set_max_width_chars(44)
        self.error.get_style_context().add_class("vt-error")
        self.error.set_no_show_all(True)

        self.stack = Gtk.Stack()
        self.stack.set_vhomogeneous(False)
        self.stack.add_named(self.build_main(), "main")
        self.stack.add_named(self.build_login(), "login")
        box.pack_start(self.stack, True, True, 0)
        box.pack_start(self.error, False, False, 0)
        frame.show_all()
        self.error.hide()

    def build_main(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        brand = Gtk.Label(label=self.vpn.name, xalign=0)         # which VPN this panel is for
        brand.get_style_context().add_class("vt-dim")
        box.pack_start(brand, False, False, 0)
        head = Gtk.Box(spacing=10)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.lbl_status = Gtk.Label(label="Checking...", xalign=0)
        self.lbl_status.get_style_context().add_class("vt-status")
        self.lbl_loc = Gtk.Label(label="", xalign=0)
        self.lbl_loc.get_style_context().add_class("vt-dim")
        self.lbl_loc.set_ellipsize(3)
        texts.pack_start(self.lbl_status, False, False, 0)
        texts.pack_start(self.lbl_loc, False, False, 0)
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.switch.connect("state-set", self.on_switch)
        head.pack_start(texts, True, True, 0)
        head.pack_end(self.switch, False, False, 0)
        box.pack_start(head, False, False, 0)

        self.btn_fastest = Gtk.Button(label="Fastest location")
        self.btn_fastest.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_fastest.get_child().set_xalign(0)
        self.btn_fastest.connect("clicked", lambda *_: self.connect_to(None))
        box.pack_start(self.btn_fastest, False, False, 0)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search locations")
        self.search.connect("search-changed", lambda *_: self.filter.refilter())
        box.pack_start(self.search, False, False, 0)

        # flag + country, city, ping text, ping, search key
        self.store = Gtk.ListStore(str, str, str, int, str)
        self.filter = self.store.filter_new()
        self.filter.set_visible_func(self.row_visible)
        tv = self.tree = Gtk.TreeView(model=self.filter)
        tv.set_headers_visible(False)
        tv.set_enable_search(False)
        for i, (xalign, expand) in enumerate(((0, True), (0, True), (1, False))):
            r = Gtk.CellRendererText(xalign=xalign)
            if i == 2:
                r.set_property("foreground", "#8a8a8a")
            col = Gtk.TreeViewColumn("", r, text=i)
            col.set_expand(expand)
            tv.append_column(col)
        tv.connect("row-activated", self.on_row)
        sw = Gtk.ScrolledWindow()
        sw.set_min_content_height(230)
        sw.set_shadow_type(Gtk.ShadowType.IN)
        sw.add(tv)
        box.pack_start(sw, True, True, 0)

        box.pack_start(Gtk.Separator(), False, False, 0)
        acc = Gtk.Box(spacing=8)
        self.lbl_acc = Gtk.Label(label="", xalign=0)
        self.lbl_acc.get_style_context().add_class("vt-dim")
        self.lbl_acc.set_ellipsize(3)
        btn_out = Gtk.Button(label="Log out")
        btn_out.connect("clicked", self.on_logout)
        acc.pack_start(self.lbl_acc, True, True, 0)
        acc.pack_end(btn_out, False, False, 0)
        box.pack_start(acc, False, False, 0)
        self.main_widgets = [self.btn_fastest, self.search, tv]
        return box

    def build_login(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        t = Gtk.Label(label=f"Log in to {self.vpn.name}", xalign=0)
        t.get_style_context().add_class("vt-status")
        self.in_email = Gtk.Entry(placeholder_text="Email")
        self.in_pass = Gtk.Entry(placeholder_text="Password", visibility=False)
        self.in_pass.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.btn_login = Gtk.Button(label="Log in")
        self.btn_login.get_style_context().add_class("suggested-action")
        self.btn_login.connect("clicked", self.on_login)
        self.in_email.connect("activate", lambda *_: self.in_pass.grab_focus())
        self.in_pass.connect("activate", self.on_login)
        for wdg in (t, self.in_email, self.in_pass, self.btn_login):
            box.pack_start(wdg, False, False, 0)
        return box

    def row_visible(self, model, it, _data):
        q = self.search.get_text().strip().lower()
        return not q or all(p in model[it][4] for p in q.split())

    def on_focus_out(self, *_):
        if time.monotonic() - self.shown_at > 0.4:  # ignore the focus flicker while mapping
            self.win.hide()
        return False

    def show_panel(self):
        self.shown_at = time.monotonic()
        self.search.set_text("")
        self.set_error("")
        display = Gdk.Display.get_default()
        _, px, py = display.get_default_seat().get_pointer().get_position()
        mon = display.get_monitor_at_point(px, py)
        wa = mon.get_workarea()
        x = max(wa.x + 8, min(px - WIDTH // 2, wa.x + wa.width - WIDTH - 8))
        self.win.move(x, wa.y + 4)
        self.win.show()
        self.win.present()
        self.refresh()

    def set_error(self, msg):
        self.error.set_text(msg)
        self.error.set_visible(bool(msg))

    # ---- state -> UI ----------------------------------------------------------------
    def render(self):
        on = bool(self.status and self.status.connected)
        logged_in = self.account is None or self.account.logged_in
        self.stack.set_visible_child_name("main" if logged_in else "login")
        if self.busy:
            pass
        elif self.status is None:
            self.lbl_status.set_text("Checking...")
        else:
            self.lbl_status.set_text("Connected" if on else "Disconnected")
            self.lbl_loc.set_text(self.status.location if on else "Not connected")
        self.switch.handler_block_by_func(self.on_switch)
        self.switch.set_active(on)
        self.switch.set_state(on)
        self.switch.handler_unblock_by_func(self.on_switch)
        for wdg in [self.switch] + self.main_widgets:
            wdg.set_sensitive(not self.busy)
        if self.account and self.account.logged_in:
            plan = f"  ({self.account.plan})" if self.account.plan else ""
            self.lbl_acc.set_text(self.account.email + plan)
        self.update_tray()

    def refresh(self, status_only=False):
        def work():
            st = self.vpn.status()
            acc = None if status_only else self.vpn.account()
            locs = None
            if (not status_only and acc.logged_in
                    and (not self.locations or time.monotonic() - self.loc_time > 300)):
                locs = self.vpn.locations()
            return st, acc, locs

        def done(res):
            if isinstance(res, Exception):
                self.set_error(str(res))
                return
            st, acc, locs = res
            self.status = st
            if acc is not None:
                self.account = acc
            if locs:
                self.locations = locs
                self.loc_time = time.monotonic()
                self.fill_locations()
            self.render()

        bg(work, done)

    def fill_locations(self):
        self.store.clear()
        for l in self.locations:
            ping = f"{l.ping} ms" if l.ping >= 0 else ""
            self.store.append([f"{l.flag} {l.country}".strip(), l.city, ping, l.ping,
                               f"{l.iso} {l.country} {l.city}".lower()])

    # ---- actions --------------------------------------------------------------------
    def act(self, label, fn, expect):
        """Run a CLI action in the background, show progress, then re-check the status."""
        if self.busy:
            return
        self.busy = True
        self.set_error("")
        self.lbl_status.set_text(label)
        self.lbl_loc.set_text("")
        self.render()

        def done(res):
            if isinstance(res, Exception):
                self.set_error(str(res))
            elif not res.ok:
                self.set_error(res.message or "The command failed")
            self.settle(expect if not isinstance(res, Exception) and res.ok else None, 8)
        bg(fn, done)

    def settle(self, expect, tries):
        """Re-read the status; if it has not reached `expect` yet, a few quick re-checks."""
        def done(st):
            if not isinstance(st, Exception):
                self.status = st
            if (expect is not None and not isinstance(st, Exception) and st.connected != expect
                    and tries > 0):
                GLib.timeout_add(1000, lambda: (self.settle(expect, tries - 1), False)[1])
                return
            self.busy = False
            self.render()
            if self.account is None or not self.account.logged_in:
                self.refresh()
        bg(self.vpn.status, done)

    def connect_to(self, city):
        self.act("Connecting...", lambda: self.vpn.connect(city), True)

    def toggle(self):
        if self.status and self.status.connected:
            self.act("Disconnecting...", self.vpn.disconnect, False)
        else:
            self.connect_to(None)

    def on_switch(self, _sw, state):
        if state != bool(self.status and self.status.connected):
            self.toggle()
        return True  # render() sets the real state

    def on_row(self, tree, path, _col):
        city = tree.get_model()[path][1]
        self.connect_to(city)

    def on_login(self, *_):
        email, pw = self.in_email.get_text().strip(), self.in_pass.get_text()
        if not email or not pw:
            self.set_error("Enter your email and password.")
            return
        self.in_pass.set_text("")

        def done(res):
            self.btn_login.set_sensitive(True)
            if isinstance(res, Exception) or not res.ok:
                self.set_error(str(res) if isinstance(res, Exception) else (res.message or "Login failed"))
            else:
                self.in_email.set_text("")
                self.refresh()
        self.btn_login.set_sensitive(False)
        self.set_error("")
        bg(lambda: self.vpn.login(email, pw), done)

    def on_logout(self, *_):
        def done(res):
            if isinstance(res, Exception) or not res.ok:
                self.set_error(str(res) if isinstance(res, Exception) else (res.message or "Log out failed"))
            self.status = None
            self.account = None
            self.locations = []
            self.store.clear()
            self.refresh()
        bg(self.vpn.logout, done)


def set_process_name(name):
    """So it can be found (and restarted) by its exact process name, not as 'python3'."""
    try:
        import ctypes
        ctypes.CDLL(None).prctl(15, name.encode(), 0, 0, 0)
    except Exception:
        pass


if __name__ == "__main__":
    set_process_name("vpntray")
    sys.exit(App().run(sys.argv))
