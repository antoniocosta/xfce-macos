#!/bin/bash
# net-badge: network latency in the top bar, like macOS's Network Badge
# (github.com/Someniak/macos-network-badge). Run by Xfce's Generic Monitor every few seconds;
# prints genmon markup: a coloured dot and the latency, with details in the tooltip.
# Clicking it runs `net-badge --popup`: the same details in a popover under the badge.
#
# Latency = the TCP handshake time of an HTTP request to Apple's captive-portal server
# (DNS lookup excluded), which is one network round trip, like a ping.
set -u
TARGET="http://captive.apple.com/hotspot-detect.html"
STATE="${XDG_RUNTIME_DIR:-/tmp}/net-badge"
HIST="$STATE/history"      # last 36 measurements in ms (blank = offline)
ALERT="$STATE/alert"       # "<quality> <epoch of last alert>"
DETAILS="$STATE/details"   # the tooltip text, for the popover
mkdir -p "$STATE"

if [[ "${1:-}" == --popup ]]; then
    # popover at the top right, under the badge; any click outside or Esc closes it
    rofi -e "$(cat "$DETAILS" 2>/dev/null || echo 'Measuring…')" -markup -theme-str '
        * { background-color: transparent; text-color: #f2f2f2; font: "Inter 10"; }
        window { location: north east; anchor: north east; x-offset: -120px; y-offset: 30px; width: 340px;
                 background-color: #2b2b2df5; border: 1px; border-color: #ffffff22; border-radius: 12px; }
        mainbox { padding: 12px 14px; }
        textbox { background-color: transparent; }'
    exit 0
fi

# one measurement
read -r dns conn code < <(curl -s -o /dev/null --max-time 3 \
    -w '%{time_namelookup} %{time_connect} %{http_code}\n' "$TARGET" 2>/dev/null || echo "0 0 000")
if [[ "$code" == 000 ]]; then
    ms=""
else
    ms=$(awk -v d="$dns" -v c="$conn" 'BEGIN { printf "%d", (c - d) * 1000 + 0.5 }')
fi

# history (one value per line, newest last)
{ tail -n 35 "$HIST" 2>/dev/null; echo "$ms"; } > "$HIST.new" && mv "$HIST.new" "$HIST"

# quality tiers, colours from macOS's palette
if [[ -z "$ms" ]];        then q="Offline";   col="#8e8e93"
elif (( ms < 30 ));  then q="Excellent"; col="#30d158"
elif (( ms < 80 ));  then q="Good";      col="#a8d93a"
elif (( ms < 150 )); then q="Fair";      col="#ffd60a"
elif (( ms < 300 )); then q="Poor";      col="#ff9f0a"
else                      q="Bad";       col="#ff453a"
fi

# connection type and Wi-Fi name
conn_line=$(nmcli -t -f TYPE,STATE,CONNECTION device 2>/dev/null | awk -F: '$2=="connected" {print $1":"$3; exit}')
ctype=${conn_line%%:*}; cname=${conn_line#*:}
case "$ctype" in
    wifi)     kind="Wi-Fi";;
    ethernet) kind="Ethernet";;
    gsm|cdma) kind="Cellular";;
    "")       kind="Not connected";;
    *)        kind="$ctype";;
esac

# sparkline of the history (offline = blank)
spark=$(awk 'BEGIN { split("▁ ▂ ▃ ▄ ▅ ▆ ▇ █", b, " ") }
    { v[NR] = $1; if ($1 != "" && $1 > max) max = $1 }
    END { if (max < 30) max = 30
          for (i = 1; i <= NR; i++) printf "%s", (v[i] == "" ? " " : b[int(v[i] / max * 7.999) + 1]) }' "$HIST")
stats=$(awk '$1 != "" { n++; s += $1; if (min == "" || $1 < min) min = $1; if ($1 > max) max = $1 }
    END { if (n) printf "min %d · avg %d · max %d ms", min, s / n, max; else printf "no replies" }' "$HIST")

# notify when it turns poor (cooldown 30 s), like the app's default alert
last_q=""; last_t=0
[[ -f "$ALERT" ]] && read -r last_q last_t < "$ALERT"
now=$(date +%s)
if [[ ( "$q" == Poor || "$q" == Bad ) && "$last_q" != Poor && "$last_q" != Bad && $(( now - last_t )) -ge 30 ]]; then
    notify-send -i network-wireless "Connection is ${q,,}" "Latency ${ms} ms on ${cname:-$kind}" 2>/dev/null
    last_t=$now
fi
echo "$q $last_t" > "$ALERT"

if [[ -n "$ms" ]]; then label="$ms ms"; detail="$ms ms"; else label="offline"; detail="no reply"; fi
# an en space and a thin space after the text: genmon ignores the panel CSS margins, so the gap lives here
printf "<txt><span foreground='%s'>●</span> %s\u2002\u2009</txt>" "$col" "$label"
details=$(printf "<b>%s</b> · %s\n%s%s\n\n<tt>%s</tt>\n%s" \
    "$q" "$detail" "$kind" "${cname:+ · $cname}" "$spark" "$stats")
printf '%s\n' "$details" > "$DETAILS"
printf "<tool>%s</tool><txtclick>%s --popup</txtclick>" "$details" "$0"
