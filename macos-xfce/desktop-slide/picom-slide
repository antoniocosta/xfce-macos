#!/bin/bash
# picom-slide: runs picom for the desktop slide, and starts it again if it dies. Two things it takes care of:
#  - Xfce's own compositor must be off for picom to run. At a login xfwm4 can still have it on for a moment
#    (picom then says "Another composite manager is already running"), so before every start it switches
#    that compositor off, and starts again if picom still does not stay up.
#  - If picom keeps dying right after it starts (a GPU driver problem), Xfce's own compositor is switched back
#    on for this session, so the screen is never left without one. The autostart entry stays: the next login
#    tries again.
# `desktop-slide on|off` starts and stops this.
fails=0
while true; do
    xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null
    sleep 0.7                                   # xfwm4 lets go of the compositor
    start=$(date +%s)
    "$HOME/.local/bin/picom" --config "$HOME/.config/picom/picom.conf"
    xprop -root >/dev/null 2>&1 || exit 0       # the session is over (logged out): stop
    if [ $(( $(date +%s) - start )) -lt 5 ]; then fails=$((fails + 1)); else fails=0; fi
    if [ "$fails" -ge 6 ]; then
        xfconf-query -c xfwm4 -p /general/use_compositing -s true
        exit 1
    fi
    sleep 1
done
