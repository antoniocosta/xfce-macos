#!/bin/bash
# desktop-switch next|prev - move one desktop over, without wrapping around (like macOS)
# When picom runs (desktop-slide on), the windows leaving and arriving are first marked
# with _MAC_SLIDE = fwd/back so picom slides them the right way; the marks are cleared
# afterwards, so switches from elsewhere (Cmd+Tab, Mission Control) stay instant.
cur=$(wmctrl -d | awk '$2=="*"{print $1}')
count=$(wmctrl -d | wc -l)
case "$1" in
  next) t=$((cur + 1)); dir=fwd ;;
  prev) t=$((cur - 1)); dir=back ;;
  *) echo "usage: desktop-switch next|prev" >&2; exit 1 ;;
esac
[ "$t" -ge 0 ] && [ "$t" -lt "$count" ] || exit 0

if pgrep -u "$USER" -x picom >/dev/null; then
    wins=$(wmctrl -l | awk -v a="$cur" -v b="$t" '$2==a || $2==b {print $1}')
    for w in $wins; do xprop -id "$w" -f _MAC_SLIDE 8s -set _MAC_SLIDE "$dir"; done
    sleep 0.03                       # let picom see the marks before the switch
    wmctrl -s "$t"
    ( sleep 0.6; for w in $wins; do xprop -id "$w" -remove _MAC_SLIDE 2>/dev/null; done ) &
else
    wmctrl -s "$t"
fi
exit 0
