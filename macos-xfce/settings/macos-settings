#!/usr/bin/python3
"""macos-settings: macOS-style settings pages for Xfce's Settings Manager.

  macos-settings dock         Desktop & Dock (Dock size, magnification, position, auto-hide, Hot Corners)
  macos-settings trackpad     Trackpad (tap to click, natural scrolling, tracking and scrolling speed)
  macos-settings displays     Displays (automatically adjust brightness)
  macos-settings keyboard     Keyboard (keyboard brightness in low light)
  macos-settings hot-corners  the Hot Corners on their own
  macos-settings --apply      (at login) put back the trackpad scroll distance and speed

Changes apply as you make them, like macOS. A page is just a window: nothing runs after you close it.
"""
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

import settings_core as core  # noqa: E402

CSS = b"""
.pane-title { font-size: 20px; font-weight: bold; }
.row-label  { font-weight: 600; }
.dim        { opacity: 0.65; }
.screen-box { background: alpha(@theme_fg_color, 0.06); border: 1px solid alpha(@theme_fg_color, 0.25);
              border-radius: 8px; }
"""


def gtk():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib, Gdk
    return Gtk, GLib, Gdk


class Debounce:
    """Write a slider's value once it settles (a one-shot, only while the window is open)."""
    def __init__(self, GLib, delay_ms=150):
        self.GLib, self.delay, self.source = GLib, delay_ms, None

    def __call__(self, fn):
        if self.source:
            self.GLib.source_remove(self.source)
        def fire():
            self.source = None
            fn()
            return False
        self.source = self.GLib.timeout_add(self.delay, fire)


def build_window(Gtk, title, width=520):
    win = Gtk.Window(title=title)
    win.set_default_size(width, -1)
    win.set_resizable(False)
    win.connect("destroy", Gtk.main_quit)
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    outer.set_border_width(22)
    head = Gtk.Label(label=title, xalign=0)
    head.get_style_context().add_class("pane-title")
    outer.pack_start(head, False, False, 0)
    grid = Gtk.Grid(column_spacing=18, row_spacing=14)
    outer.pack_start(grid, True, True, 0)
    win.add(outer)
    return win, outer, grid


def row(Gtk, grid, n, label, widget, note=None):
    lab = Gtk.Label(label=label, xalign=1, wrap=True, justify=Gtk.Justification.RIGHT)
    lab.set_max_width_chars(22)                       # long labels wrap instead of widening the window
    lab.get_style_context().add_class("row-label")
    lab.set_valign(Gtk.Align.CENTER)
    grid.attach(lab, 0, n, 1, 1)
    widget.set_hexpand(True)
    grid.attach(widget, 1, n, 1, 1)
    if note:
        nl = Gtk.Label(label=note, xalign=0, wrap=True)
        nl.set_max_width_chars(38)                    # the same for the notes underneath
        nl.get_style_context().add_class("dim")
        grid.attach(nl, 1, n + 1, 1, 1)


def switch(Gtk, active, on_change, sensitive=True):
    sw = Gtk.Switch(active=active, halign=Gtk.Align.START, valign=Gtk.Align.CENTER)
    sw.set_sensitive(sensitive)
    sw.connect("notify::active", lambda s, _: on_change(s.get_active()))
    return sw


def slider(Gtk, lo, hi, value, step, left, right, on_change):
    """A labelled slider: (box, scale)."""
    box = Gtk.Box(spacing=8)
    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
    scale.set_value(value)
    scale.set_draw_value(False)
    scale.set_hexpand(True)
    scale.connect("value-changed", lambda s: on_change(s.get_value()))
    for text, where in ((left, "start"), (None, "scale"), (right, "end")):
        if where == "scale":
            box.pack_start(scale, True, True, 0)
        else:
            lab = Gtk.Label(label=text)
            lab.get_style_context().add_class("dim")
            box.pack_start(lab, False, False, 0)
    return box, scale


# ---- Desktop & Dock -------------------------------------------------------------------------

def pane_dock():
    Gtk, GLib, _ = gtk()
    win, outer, grid = build_window(Gtk, "Desktop & Dock")
    st = core.dock_state()
    deb = Debounce(GLib)

    box, size = slider(Gtk, 16, 128, st["size"], 1, "Small", "Large",
                       lambda v: deb(lambda: core.set_dock("size", v)))
    row(Gtk, grid, 0, "Size:", box)

    mag_box = Gtk.Box(spacing=10, orientation=Gtk.Orientation.VERTICAL)
    mag_sw = switch(Gtk, st["magnify"], lambda on: (core.set_dock("magnify", on), msl.set_sensitive(on)))
    mag_box.pack_start(mag_sw, False, False, 0)
    msl_box, msl = slider(Gtk, 100, 400, st["magnify_size"], 5, "Min", "Max",
                          lambda v: deb(lambda: core.set_dock("magnify_size", v)))
    msl.set_sensitive(st["magnify"])
    mag_box.pack_start(msl_box, False, False, 0)
    row(Gtk, grid, 1, "Magnification:", mag_box)

    pos = Gtk.Box(spacing=14)
    first = None
    for label, key in (("Left", "left"), ("Bottom", "bottom"), ("Right", "right")):
        rb = Gtk.RadioButton.new_with_label_from_widget(first, label)
        first = first or rb
        rb.set_active(st["position"] == key)
        rb.connect("toggled", lambda b, k=key: b.get_active() and core.set_dock("position", k))
        pos.pack_start(rb, False, False, 0)
    row(Gtk, grid, 2, "Position on screen:", pos)

    row(Gtk, grid, 3, "Automatically hide and show the Dock:",
        switch(Gtk, st["autohide"], lambda on: core.set_dock("autohide", on)))

    slide_on = core.slide_is_on()
    row(Gtk, grid, 4, "Slide between desktops:", switch(Gtk, slide_on, core.set_slide),
        note="The picture slides when you switch desktops. Turning it off hands drawing back to "
             "Xfce's own compositor.")

    frame = Gtk.Frame(label="Hot Corners")
    block = hot_corners_block(Gtk, GLib)
    block.set_border_width(12)
    frame.add(block)
    outer.pack_start(frame, False, False, 0)
    return win


# ---- Hot Corners ---------------------------------------------------------------------------

def restart_hot_corners():
    """hot-corners reads the saved choice when it starts, and replaces a running copy itself."""
    env = dict(os.environ, PATH=os.path.expanduser("~/.local/bin") + ":" + os.environ.get("PATH", ""))
    subprocess.Popen(["hot-corners"], start_new_session=True, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, env=env)


def hot_corners_block(Gtk, GLib):
    """The four corner choices around a small screen, applied as you change them."""
    cur = core.load_hot_corners()
    combos = {}
    deb = Debounce(GLib, 400)

    def changed(*_):
        def apply():
            core.save_hot_corners({c: combos[c].get_active_id() or "none" for c in core.CORNERS})
            restart_hot_corners()
        deb(apply)

    def combo(corner):
        c = Gtk.ComboBoxText()
        for key, name in core.HOT_ACTIONS:
            c.append(key, name)
        c.set_active_id(cur[corner])
        c.set_valign(Gtk.Align.CENTER)
        c.connect("changed", changed)
        combos[corner] = c
        return c

    grid = Gtk.Grid(column_spacing=12, row_spacing=12, halign=Gtk.Align.CENTER)
    grid.attach(combo("tl"), 0, 0, 1, 1)
    grid.attach(combo("tr"), 2, 0, 1, 1)
    screen = Gtk.Box()
    screen.set_size_request(96, 64)
    screen.get_style_context().add_class("screen-box")
    grid.attach(screen, 1, 0, 1, 3)
    grid.attach(combo("bl"), 0, 2, 1, 1)
    grid.attach(combo("br"), 2, 2, 1, 1)
    hint = Gtk.Label(label="Rest the pointer in a corner of the screen to do this.", xalign=0.5, wrap=True)
    hint.set_max_width_chars(40)
    hint.get_style_context().add_class("dim")
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.pack_start(grid, False, False, 0)
    box.pack_start(hint, False, False, 0)
    return box


def pane_hot_corners():
    Gtk, GLib, _ = gtk()
    win, outer, grid = build_window(Gtk, "Hot Corners")
    row(Gtk, grid, 0, "Corners:", hot_corners_block(Gtk, GLib))
    return win


# ---- Trackpad ------------------------------------------------------------------------------

def pane_trackpad():
    Gtk, GLib, _ = gtk()
    win, outer, grid = build_window(Gtk, "Trackpad")
    st = core.trackpad_state()
    if st is None:
        note = Gtk.Label(label="No trackpad found.", xalign=0)
        outer.pack_start(note, False, False, 0)
        return win
    deb = Debounce(GLib)
    conf = core.load_trackpad_conf()

    row(Gtk, grid, 0, "Tap to click:", switch(
        Gtk, st["tap"], lambda on: (core.set_xfce_pointer(st["name"], "tap", on),
                                    core.xinput_set(st["device"], "libinput Tapping Enabled", [int(on)]))))
    row(Gtk, grid, 1, "Natural scrolling:", switch(
        Gtk, st["natural"], lambda on: (core.set_xfce_pointer(st["name"], "natural", on),
                                        core.xinput_set(st["device"], "libinput Natural Scrolling Enabled", [int(on)]))),
        note="Content follows your fingers, as on a Mac.")

    def ignore_typing(on):
        core.xinput_set(st["device"], "libinput Disable While Typing Enabled", [int(on)])
        core.save_trackpad_conf({**core.load_trackpad_conf(), "ignore_typing": "1" if on else "0"})
    row(Gtk, grid, 2, "Ignore the trackpad while typing:", switch(Gtk, st["ignore_typing"], ignore_typing),
        note="Off, as on a Mac, so holding Space and dragging works (panning in Figma or Photoshop). "
             "Turn it on if your palm touches the trackpad while you type.")

    def speed(v):
        core.xinput_set(st["device"], "libinput Accel Speed", [round(v, 2)])
        core.save_trackpad_conf({**core.load_trackpad_conf(), "speed": round(v, 2)})
    box, _ = slider(Gtk, -1.0, 1.0, st["speed"], 0.05, "Slow", "Fast", lambda v: deb(lambda: speed(v)))
    row(Gtk, grid, 3, "Tracking speed:", box)

    def scroll(v):
        d = core.scroll_speed_to_distance(v)
        core.xinput_set(st["device"], "libinput Scrolling Pixel Distance", [d])
        core.save_trackpad_conf({**core.load_trackpad_conf(), "scroll_distance": d})
    start = core.distance_to_scroll_speed(int(conf.get("scroll_distance", st["scroll_distance"])))
    box, _ = slider(Gtk, 1, 10, start, 1, "Slow", "Fast", lambda v: deb(lambda: scroll(v)))
    row(Gtk, grid, 4, "Scrolling speed:", box,
        note="How far your fingers travel for each scroll step. Saved and applied at every login.")
    return win


# ---- Displays and Keyboard -----------------------------------------------------------------

def pane_displays():
    Gtk, _, _ = gtk()
    win, outer, grid = build_window(Gtk, "Displays")
    st = core.load_brightness()
    sensor = core.has_light_sensor()
    row(Gtk, grid, 0, "Automatically adjust brightness:", switch(
        Gtk, st["screen"], lambda on: core.save_brightness(on, core.load_brightness()["keyboard"]), sensor),
        note=("The screen follows the room light, using the ambient light sensor." if sensor else
              "This computer has no ambient light sensor."))
    return win


def pane_keyboard():
    Gtk, _, _ = gtk()
    win, outer, grid = build_window(Gtk, "Keyboard Brightness")
    st = core.load_brightness()
    ok = core.has_keyboard_backlight() and core.has_light_sensor()
    row(Gtk, grid, 0, "Adjust keyboard brightness in low light:", switch(
        Gtk, st["keyboard"], lambda on: core.save_brightness(core.load_brightness()["screen"], on), ok),
        note=("The keyboard light comes on in the dark and off in bright light. It also goes off when the "
              "screen goes to sleep (Power Manager's display setting) and comes back at the first key." if ok else
              "This computer has no keyboard backlight or no ambient light sensor."))
    return win


PANES = {"dock": pane_dock, "trackpad": pane_trackpad, "displays": pane_displays, "keyboard": pane_keyboard,
         "hot-corners": pane_hot_corners}


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--apply":
        sys.exit(0 if core.apply_trackpad_conf() else 1)
    if arg not in PANES:
        print(__doc__)
        sys.exit(2)
    Gtk, GLib, Gdk = gtk()
    css = Gtk.CssProvider()
    css.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = PANES[arg]()
    if win is None:
        return
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
