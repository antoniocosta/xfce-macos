#!/bin/bash
# macOS-style hot corners: top-right = show desktop, bottom-right = Mission Control;
# (dragging windows across desktops is xfwm4's own wrap_windows)
# Restarts hotcorner if it ever stops.
for p in $(pgrep -u "$USER" -x hot-corners); do [ "$p" != $$ ] && kill "$p"; done
pkill -u "$USER" -x hotcorner 2>/dev/null
while true; do
  "$HOME/.local/bin/hotcorner" -d 100 \
    tr "$HOME/.local/bin/show-desktop" \
    br "$HOME/.local/bin/mission-control"
  sleep 2
done
