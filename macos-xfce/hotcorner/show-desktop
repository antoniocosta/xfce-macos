#!/bin/sh
# show-desktop: like macOS, per desktop. Hides the windows on THIS desktop only (remembering which),
# and a second call brings back exactly those. Xfce's own "show desktop" is global: it hides every
# desktop's windows and stays on as you switch, so an empty desktop would empty the others.
#   - nothing to hide (an empty desktop): does nothing
#   - a full-screen app is its own Space with no desktop behind it: does nothing
#   - bringing windows back always works, from any desktop
state="${XDG_RUNTIME_DIR:-/tmp}/show-desktop"
mkdir -p "$state"
cur=$(xprop -root _NET_CURRENT_DESKTOP 2>/dev/null | awk '{print $3}')
file="$state/$cur"

hidden() { xprop -id "$1" _NET_WM_STATE 2>/dev/null | grep -q _NET_WM_STATE_HIDDEN; }

# windows we hid here earlier: bring them back (the ones still there and still hidden)
if [ -s "$file" ]; then
    back=0
    while read -r w; do
        if hidden "$w"; then xdotool windowactivate "$w" 2>/dev/null && back=1; fi
    done < "$file"
    rm -f "$file"
    [ "$back" = 1 ] && exit 0
fi

# otherwise hide this desktop's normal windows
list=""
for w in $(wmctrl -l | awk -v d="$cur" '$2 == d {print $1}'); do
    state_w=$(xprop -id "$w" _NET_WM_STATE 2>/dev/null)
    case "$state_w" in *_NET_WM_STATE_FULLSCREEN*) rm -f "$file"; exit 0 ;; esac   # a Space: nothing to show
    case "$state_w" in *_NET_WM_STATE_HIDDEN*) continue ;; esac                    # already minimized by you
    list="$list $w"
done
[ -z "$list" ] && exit 0
for w in $list; do
    xdotool windowminimize "$w" 2>/dev/null && echo "$w" >> "$file"
done
